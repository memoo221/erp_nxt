<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        DEMO DATA: the real client PO No. 65282 from Etisalat Misr, entered
        completely, plus invented sourcing data (vendors, quotes, purchases) so
        that every screen has something to show.

        Demo files are only loaded into databases created with "Demo data"
        ticked. Each <record> has an id; other records point at it with ref="".

        What is REAL (copied from the PO): everything on the sales order and its
        lines, milestones and delivery groups.
        What is INVENTED for the demo: the three vendors, their quotes, the
        purchases, and advance_payment_received_date.
    -->

    <!-- Egyptian VAT. The main company's chart of accounts has no 14% tax. -->
    <record id="tax_vat_14_sale" model="account.tax">
        <field name="name">14% VAT</field>
        <field name="amount">14</field>
        <field name="amount_type">percent</field>
        <field name="type_tax_use">sale</field>
        <field name="company_id" ref="base.main_company"/>
    </record>

    <!-- A sales order takes its currency from its pricelist. -->
    <record id="pricelist_usd" model="product.pricelist">
        <field name="name">USD (Client POs)</field>
        <field name="currency_id" ref="base.USD"/>
    </record>

    <!-- 50% advance / 50% within 15 days of delivery completion. The detailed
         split (with and without LG) is in the payment milestones below. -->
    <record id="payment_term_po_65282" model="account.payment.term">
        <field name="name">50% advance, 50% 15 days after delivery completion</field>
        <field name="line_ids" eval="[
            Command.clear(),
            Command.create({'value': 'percent', 'value_amount': 50, 'nb_days': 0}),
            Command.create({'value': 'percent', 'value_amount': 50, 'nb_days': 15}),
        ]"/>
    </record>

