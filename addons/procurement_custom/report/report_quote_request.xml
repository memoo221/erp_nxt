<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Request list sent to a vendor: the items and quantities we want a price
        for. `docs` are procurement.quote records; they are regrouped here so
        that each (client PO, vendor) pair gets its own page.

        This template must never print the client's name, PO number or prices:
        the vendor only learns WHAT we need, not for whom or at what price.
    -->
    <template id="report_quote_request">
        <t t-call="web.html_container">
            <t t-foreach="docs.mapped('order_id')" t-as="order">
                <t t-set="order_quotes" t-value="docs.filtered(lambda q: q.order_id == order)"/>
                <t t-foreach="order_quotes.mapped('vendor_id')" t-as="vendor">
                    <t t-set="vendor_quotes"
                       t-value="order_quotes.filtered(lambda q: q.vendor_id == vendor).sorted(lambda q: (q.client_line_no, q.id))"/>
                    <!-- external_layout reads the company from the variable `o`. -->
                    <t t-set="o" t-value="order"/>
                    <t t-call="web.external_layout">
                        <div class="page">
                            <h3>Request for Quotation</h3>
                            <table class="table table-sm table-borderless mb-3" style="width: 60%;">
                                <tr>
                                    <td class="fw-bold">To</td>
                                    <td><span t-field="vendor.name"/></td>
                                </tr>
                                <tr>
                                    <td class="fw-bold">Our Reference</td>
                                    <td><span t-field="order.name"/></td>
                                </tr>
                                <tr>
                                    <td class="fw-bold">Date</td>
                                    <td><span t-out="context_timestamp(datetime.datetime.now()).strftime('%Y-%m-%d')"/></td>
                                </tr>
                            </table>
                            <p>Please send us your best unit price and delivery time for the items below.</p>
                            <table class="table table-sm" name="request_lines">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Item Code</th>
                                        <th>Description</th>
                                        <th>UOM</th>
                                        <th class="text-end">Quantity</th>
                                        <th class="text-end">Your Unit Price</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="vendor_quotes" t-as="quote">
                                        <t t-set="line" t-value="quote.sale_line_id"/>
                                        <td><span t-out="quote_index + 1"/></td>
                                        <td><span t-out="line.client_item_code or line.product_id.default_code or ''"/></td>
                                        <td><span t-out="line.description_printed or line.label"/></td>
                                        <td><span t-out="line.uom_printed or line.product_uom_id.name"/></td>
                                        <td class="text-end"><span t-out="'%g' % line.product_uom_qty"/></td>
                                        <td/>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </t>
                </t>
            </t>
        </t>
    </template>
</odoo>
