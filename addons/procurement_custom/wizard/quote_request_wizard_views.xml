<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- A view is a record of the model ir.ui.view whose `arch` field holds the
         XML that describes the screen. -->
    <record id="view_quote_request_wizard_form" model="ir.ui.view">
        <field name="name">procurement.quote.request.wizard.form</field>
        <field name="model">procurement.quote.request.wizard</field>
        <field name="arch" type="xml">
            <form string="Request Quotes">
                <group>
                    <field name="order_id"/>
                </group>
                <p class="text-muted">
                    1. Click "Add a line" and choose a vendor.
                    2. On the same row, click in the "Items to request" column and pick
                    items from the dropdown (only this PO's items are listed), or tick
                    "All Items". Pairs already requested are skipped.
                </p>
                <!-- A One2many shown as an editable list: rows are typed in place. -->
                <field name="line_ids">
                    <list editable="bottom">
                        <field name="order_id" column_invisible="True"/>
                        <field name="vendor_id" width="250px"
                               context="{'res_partner_search_mode': 'supplier', 'default_supplier_rank': 1, 'default_is_company': True}"/>
                        <field name="all_items" width="90px"/>
                        <!-- many2many_tags: a dropdown to pick from; each
                             picked item becomes a removable tag. The context
                             key switches the items to their short label. -->
                        <!-- `parent` is the dialog itself: the dropdown is limited
                             to the items of the PO shown at the top. -->
                        <field name="sale_line_ids" widget="many2many_tags"
                               string="Items to request (click here to pick)"
                               options="{'no_create': True}"
                               domain="[('order_id', '=', parent.order_id), ('display_type', '=', False)]"
                               context="{'procurement_item_name': True}"
                               placeholder="Pick items of this PO..."/>
                    </list>
                </field>
                <footer>
                    <!-- type="object": calls the Python method named in `name`. -->
                    <button name="action_create_requests" type="object"
                            string="Create Quote Requests" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
